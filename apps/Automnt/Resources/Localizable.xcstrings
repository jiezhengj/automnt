    "This login setting opens the menu bar. Background automatic mounting is controlled separately.": {
      "comment": "Independent SMAppService mainApp login preference; draft native review pending.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This login setting opens the menu bar. Background automatic mounting is controlled separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此登录设置用于打开菜单栏。后台自动挂载单独控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此登入設定用於開啟選單列。背景自動掛載另行控制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このログイン設定はメニューバーを開きます。バックグラウンドの自動マウントは別に設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그인 설정은 메뉴 막대를 엽니다. 백그라운드 자동 마운트는 별도로 제어합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldeeinstellung öffnet die Menüleiste. Automatisches Einbinden im Hintergrund wird separat gesteuert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage de connexion ouvre la barre des menus. Le montage automatique en arrière-plan est contrôlé séparément."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste abre la barra de menús al iniciar sesión. El montaje automático en segundo plano se controla por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
