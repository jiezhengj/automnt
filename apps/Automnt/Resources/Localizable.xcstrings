            "state": "translated",
            "value": "Automatic recovery settings were saved. Check background mounting to apply the change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动恢复设置已存储。请检查后台挂载以应用更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
