    "Allow Automnt to read and save its configuration in this folder. Existing CLI targets will appear automatically.": {
      "comment": "Fixed canonical configuration authorization. Non-English translations are drafts awaiting native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Automnt to read and save its configuration in this folder. Existing CLI targets will appear automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Automnt 在此文件夹读取和保存配置。已有 CLI 目标会自动显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Automnt 在此檔案夾讀取和儲存設定。既有 CLI 目標會自動顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダ内の設定の読み取りと保存を Automnt に許可してください。既存の CLI の接続先は自動的に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt가 이 폴더에서 구성을 읽고 저장하도록 허용하세요. 기존 CLI 대상이 자동으로 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Automnt, seine Konfiguration in diesem Ordner zu lesen und zu speichern. Vorhandene CLI-Ziele werden automatisch angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Automnt à lire et enregistrer sa configuration dans ce dossier. Les destinations CLI existantes apparaîtront automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Automnt lea y guarde su configuración en esta carpeta. Los destinos existentes de la CLI aparecerán automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Automnt leia e salve sua configuração nesta pasta. Os destinos existentes da CLI aparecerão automaticamente."
          }
        }
      }
    },
    "Choose the automnt folder at the location shown below. Other folders and configuration copies cannot be used.": {
