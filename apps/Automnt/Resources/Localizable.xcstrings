    "Review the redacted diagnostics before exporting. Nothing is uploaded automatically.": {
      "comment": "Native redacted diagnostic preview and explicit user export. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the redacted diagnostics before exporting. Nothing is uploaded automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出前请检查脱敏诊断内容。不会自动上传任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出前請檢查去識別化的診斷內容。不會自動上傳任何內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出す前に匿名化された診断内容を確認してください。自動アップロードは行われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기 전에 민감한 정보가 제거된 진단을 검토하세요. 자동으로 업로드되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie die anonymisierten Diagnosedaten vor dem Export. Es wird nichts automatisch hochgeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les diagnostics anonymisés avant de les exporter. Rien n’est envoyé automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el diagnóstico anonimizado antes de exportarlo. No se sube nada automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise o diagnóstico anonimizado antes de exportar. Nada é enviado automaticamente."
          }
        }
      }
    },
