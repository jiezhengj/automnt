          "stringUnit": {
            "state": "translated",
            "value": "选择同一服务器的共享并添加。此列表仅显示当前已挂载的共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇同一伺服器的共享並加入。此列表僅顯示目前已掛載的共享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じサーバの共有フォルダを選択して追加します。現在マウントされているフォルダのみ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 서버의 공유 폴더를 선택하여 추가하세요. 현재 마운트된 폴더만 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Ordner eines Servers zum Hinzufügen aus. Diese Liste enthält nur aktuell gemountete Ordner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez les dossiers d’un même serveur à ajouter. Seuls les dossiers actuellement montés figurent ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona carpetas de un mismo servidor para añadirlas. Solo se muestran las carpetas montadas actualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione pastas de um mesmo servidor para adicioná-las. Apenas pastas montadas atualmente são exibidas."
          }
        }
      }
    },
    "No mounted SMB shared folders were found. Enter an SMB address manually.": {
