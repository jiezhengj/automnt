    "Enter an SMB address without a username or password. Leave the mount folder empty to use its standard folder in /Volumes.": {
      "comment": "Guidance under the shared folder fields. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an SMB address without a username or password. Leave the mount folder empty to use its standard folder in /Volumes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不含用户名和密码的 SMB 地址。挂载文件夹留空时，将使用 /Volumes 中的标准文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入不含使用者名稱與密碼的 SMB 位址。掛載檔案夾留空時，將使用 /Volumes 中的標準檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザ名とパスワードを含まないSMBアドレスを入力してください。マウント先フォルダを空にすると、/Volumes内の標準フォルダが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 이름과 암호가 없는 SMB 주소를 입력하세요. 마운트 폴더를 비워 두면 /Volumes의 표준 폴더가 사용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine SMB-Adresse ohne Benutzername und Passwort ein. Lass den Einhängepunkt leer, um den Standardordner in /Volumes zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse SMB sans nom d’utilisateur ni mot de passe. Laissez le point de montage vide pour utiliser son dossier standard dans /Volumes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una dirección SMB sin nombre de usuario ni contraseña. Deja el punto de montaje vacío para usar su carpeta estándar en /Volumes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um endereço SMB sem nome de usuário e senha. Deixe a pasta de montagem vazia para usar a pasta padrão em /Volumes."
          }
        }
      }
    },
