    "Recover disconnected shared folders after mount changes. This preference is preserved while automatic mounting is off.": {
      "comment": "Settings explanation for automatic recovery. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover disconnected shared folders after mount changes. This preference is preserved while automatic mounting is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载状态变化后恢复已断开的共享文件夹。自动挂载关闭时，此偏好仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掛載狀態變更後復原已中斷的共享檔案夾。自動掛載關閉時，此偏好仍會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウントの変化後に切断された共有フォルダの復旧を試みます。自動マウントがオフでもこの設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마운트 변경 후 연결이 끊긴 공유 폴더를 복구합니다. 자동 마운트가 꺼져 있어도 이 설정은 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt getrennte freigegebene Ordner nach Änderungen am Verbindungsstatus wieder her. Diese Einstellung bleibt erhalten, solange das automatische Verbinden aus ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les dossiers partagés déconnectés après un changement de montage. Ce réglage est conservé même lorsque le montage automatique est désactivé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera las carpetas compartidas desconectadas tras cambios de montaje. Esta preferencia se mantiene aunque el montaje automático esté desactivado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera pastas compartilhadas desconectadas após mudanças de montagem. Esta preferência é mantida enquanto a montagem automática estiver desativada."
          }
        }
      }
    },
