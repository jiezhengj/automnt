    "The eject result could not be confirmed. Automatic recovery is paused until the operation is repaired.": {
      "comment": "Error message when an eject result requires reconciliation. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The eject result could not be confirmed. Automatic recovery is paused until the operation is repaired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认弹出结果。修复该操作前，自动恢复将暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認退出結果。修復該操作前，自動復原會暫停。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り出しの結果を確認できませんでした。操作が修復されるまで、自動復旧は一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출 결과를 확인할 수 없습니다. 작업이 복구될 때까지 자동 복구가 일시 중지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis des Auswerfens konnte nicht bestätigt werden. Die automatische Wiederherstellung ist pausiert, bis der Vorgang behoben ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de l’éjection n’a pas pu être confirmé. Le rétablissement automatique est suspendu jusqu’à la réparation de l’opération."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido confirmar el resultado de la expulsión. La recuperación automática está en pausa hasta que se repare la operación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o resultado da ejeção. A recuperação automática fica pausada até a operação ser reparada."
          }
        }
      }
    },
    "Shared folder ejected. It will stay disconnected until the network or login session changes.": {
      "comment": "Status message after a successful eject. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared folder ejected. It will stay disconnected until the network or login session changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已弹出共享文件夹。在网络或登录会话发生变化前，它将保持断开状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出共享檔案夾。在網路或登入階段變更前，它會保持中斷連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダを取り出しました。ネットワークまたはログインセッションが変わるまで接続されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 폴더를 추출했습니다. 네트워크 또는 로그인 세션이 바뀔 때까지 연결되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigegebener Ordner ausgeworfen. Er bleibt getrennt, bis sich das Netzwerk oder die Anmeldesitzung ändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier partagé éjecté. Il restera déconnecté jusqu’au changement de réseau ou de session de connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta compartida expulsada. Permanecerá desconectada hasta que cambien la red o la sesión de inicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta compartilhada ejetada. Ela permanecerá desconectada até a rede ou a sessão de login mudar."
          }
        }
      }
    },
    "Automatic mounting is on. Check background mounting before continuing.": {
      "comment": "Status message after enabling automatic mounting. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
