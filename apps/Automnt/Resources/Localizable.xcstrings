    "Allow notifications to receive alerts when automatic recovery is incomplete.": {
      "comment": "Notification settings. Complete sentence; no parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications to receive alerts when automatic recovery is incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通知，以便在自动恢复未完成时收到提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許通知，以便在自動恢復未完成時收到提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動復元が完了しなかったときに通知を受け取るには、通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 복구가 완료되지 않았을 때 알림을 받으려면 알림을 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen, um Hinweise zu erhalten, wenn die automatische Wiederherstellung unvollständig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications pour être averti lorsque le rétablissement automatique est incomplet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones para recibir avisos cuando la recuperación automática no se complete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita notificações para receber alertas quando a restauração automática não for concluída."
          }
        }
      }
    },
    "Notifications are off. Allow Automnt notifications in System Settings to receive recovery alerts.": {
      "comment": "Notification settings. Complete sentence; no parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Allow Automnt notifications in System Settings to receive recovery alerts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。请在系统设置中允许 Automnt 通知，以接收恢复提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉。請在系統設定中允許 Automnt 通知，以接收復原提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はオフです。復元の通知を受け取るには、システム設定で Automnt の通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 복구 알림을 받으려면 시스템 설정에서 Automnt 알림을 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Erlaube Automnt-Mitteilungen in den Systemeinstellungen, um Hinweise zur Wiederherstellung zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Autorisez les notifications d’Automnt dans Réglages Système pour recevoir les alertes de rétablissement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Permite las notificaciones de Automnt en Ajustes del Sistema para recibir avisos de recuperación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Permita notificações do Automnt nos Ajustes do Sistema para receber alertas de recuperação."
          }
        }
      }
    },
    "Notification access could not be checked. Check Notifications in System Settings.": {
      "comment": "Notification settings. Complete sentence; no parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification access could not be checked. Check Notifications in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查通知权限。请检查系统设置中的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查通知權限。請檢查系統設定中的通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の許可を確認できませんでした。システム設定の「通知」を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한을 확인할 수 없습니다. 시스템 설정에서 알림을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungserlaubnis konnte nicht geprüft werden. Prüfe „Mitteilungen“ in den Systemeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier l’autorisation des notifications. Vérifiez Notifications dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar el permiso de notificaciones. Revisa Notificaciones en Ajustes del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a permissão de notificações. Verifique Notificações nos Ajustes do Sistema."
          }
        }
      }
    },
    "Notification access could not be requested. Try again or check Notifications in System Settings.": {
      "comment": "Notification settings. Complete sentence; no parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification access could not be requested. Try again or check Notifications in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法申请通知权限。请重试，或检查系统设置中的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法申請通知權限。請重試，或檢查系統設定中的通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の許可を要求できませんでした。再試行するか、システム設定の「通知」を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한을 요청할 수 없습니다. 다시 시도하거나 시스템 설정에서 알림을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungserlaubnis konnte nicht angefordert werden. Versuche es erneut oder prüfe „Mitteilungen“ in den Systemeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de demander l’autorisation des notifications. Réessayez ou vérifiez Notifications dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido solicitar el permiso de notificaciones. Inténtalo de nuevo o revisa Notificaciones en Ajustes del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível solicitar a permissão de notificações. Tente novamente ou verifique Notificações nos Ajustes do Sistema."
          }
        }
      }
    },
    "Notification sound is off because its settings could not be read. Choose your preference to repair them.": {
      "comment": "Notification settings. Complete sentence; no parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification sound is off because its settings could not be read. Choose your preference to repair them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取声音设置，通知声音已关闭。请选择声音偏好以修复设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取音效設定，通知音效已關閉。請選擇音效偏好以修復設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込めなかったため、通知音はオフです。通知音の設定を選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 읽을 수 없어 알림 소리가 꺼져 있습니다. 소리 설정을 다시 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mitteilungston ist deaktiviert, weil die Einstellungen nicht gelesen werden konnten. Wähle deine Einstellung erneut, um sie zu reparieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son des notifications est désactivé, car ses réglages n’ont pas pu être lus. Choisissez à nouveau votre préférence pour les réparer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido de las notificaciones está desactivado porque no se han podido leer sus ajustes. Vuelve a elegir tu preferencia para repararlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som das notificações está desativado porque não foi possível ler seus ajustes. Escolha sua preferência novamente para repará-los."
          }
        }
      }
    },
    "Allow Automnt in Login Items in System Settings, then check again.": {
      "comment": "Background mounting approval guidance shown in the main window and in action guidance. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Automnt in Login Items in System Settings, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”的“登录项”中允许 Automnt，然后再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」的「登入項目」中允許 Automnt，然後再次檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定の「ログイン項目」で Automnt を許可してから、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정의 로그인 항목에서 Automnt를 허용한 다음 다시 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Automnt in den Systemeinstellungen unter „Anmeldeobjekte“ und prüfe dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Automnt dans « Ouverture » des Réglages Système, puis vérifiez à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Automnt en «Ítems de inicio» de Ajustes del Sistema y vuelve a comprobar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Automnt em “Itens de Início” nos Ajustes do Sistema e verifique novamente."
          }
        }
      }
    },
    "App background mounting is off. Mounted shared folders remain available.": {
      "comment": "Status message after the app background service stops. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App background mounting is off. Mounted shared folders remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用后台挂载已关闭。已挂载的共享文件夹仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 背景掛載已關閉。已掛載的共享檔案夾仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appのバックグラウンドマウントはオフです。マウント済みの共有フォルダは引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 백그라운드 마운트가 꺼져 있습니다. 이미 마운트된 공유 폴더는 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrund-Verbinden der App ist aus. Verbundene freigegebene Ordner bleiben verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage en arrière-plan de l’app est désactivé. Les dossiers partagés déjà montés restent disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje en segundo plano de la app está desactivado. Las carpetas compartidas ya montadas siguen disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A montagem em segundo plano do app está desativada. As pastas compartilhadas já montadas continuam disponíveis."
          }
        }
      }
    },
    "App background mounting is enabled. Shared folders will mount when the server and credentials are available.": {
      "comment": "Status message after the app background service starts. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App background mounting is enabled. Shared folders will mount when the server and credentials are available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用后台挂载已启用。服务器和登录信息可用时，共享文件夹会自动挂载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 背景掛載已啟用。伺服器與登入資訊可用時，共享檔案夾會自動掛載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appのバックグラウンドマウントが有効になりました。サーバとログイン情報を利用できるときに共有フォルダがマウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 백그라운드 마운트가 활성화되었습니다. 서버와 로그인 정보를 사용할 수 있으면 공유 폴더가 마운트됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrund-Verbinden der App ist aktiviert. Freigegebene Ordner werden verbunden, sobald Server und Anmeldedaten verfügbar sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage en arrière-plan de l’app est activé. Les dossiers partagés seront montés dès que le serveur et les identifiants seront disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje en segundo plano de la app está activado. Las carpetas compartidas se montarán cuando el servidor y las credenciales estén disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A montagem em segundo plano do app está ativada. As pastas compartilhadas serão montadas quando o servidor e as credenciais estiverem disponíveis."
          }
        }
      }
    },
    "App control is selected. Ejecting disconnects the shared folder for this network and login session.": {
      "comment": "Action guidance when the app owns automatic mounting. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App control is selected. Ejecting disconnects the shared folder for this network and login session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择由应用控制。弹出会在此网络和登录会话中断开该共享文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選擇由 App 控制。退出會在此網路與登入階段中中斷該共享檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appによる制御が選択されています。取り出すと、このネットワークとログインセッションでは共有フォルダが切断されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 제어가 선택되어 있습니다. 추출하면 이 네트워크 및 로그인 세션에서 공유 폴더 연결이 끊어집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Steuerung ist ausgewählt. Auswerfen trennt den freigegebenen Ordner für dieses Netzwerk und diese Anmeldesitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle par l’app est sélectionné. Éjecter déconnecte le dossier partagé pour ce réseau et cette session de connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está seleccionado el control por la app. Expulsar desconecta la carpeta compartida en esta red y esta sesión de inicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle pelo app está selecionado. Ejetar desconecta a pasta compartilhada nesta rede e nesta sessão de login."
          }
        }
      }
    },
    "The command-line service controls mounting. Switch to app control before ejecting here.": {
      "comment": "Action guidance when the command-line service owns automatic mounting. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command-line service controls mounting. Switch to app control before ejecting here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载由命令行服务控制。请先切换为应用控制，再在此弹出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掛載由命令列服務控制。請先切換為 App 控制，再在此退出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウントはコマンドラインサービスが制御しています。ここで取り出す前に、Appによる制御に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마운트는 명령줄 서비스가 제어합니다. 여기서 추출하려면 먼저 앱 제어로 전환하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verbinden wird vom Befehlszeilendienst gesteuert. Wechsle zur App-Steuerung, bevor du hier auswirfst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service en ligne de commande contrôle le montage. Passez au contrôle par l’app avant d’éjecter ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de línea de comandos controla el montaje. Cambia al control por la app antes de expulsar aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de linha de comando controla a montagem. Mude para o controle pelo app antes de ejetar aqui."
          }
        }
      }
    },
    "Set up app background mounting before ejecting here. You can still open mounted folders in Finder.": {
      "comment": "Action guidance when app background mounting has not been set up. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up app background mounting before ejecting here. You can still open mounted folders in Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先设置应用后台挂载，再在此弹出。你仍可在 Finder 中打开已挂载的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先設定 App 背景掛載，再在此退出。你仍可在 Finder 中打開已掛載的檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで取り出す前に、Appのバックグラウンドマウントを設定してください。マウント済みのフォルダはFinderで開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 추출하려면 먼저 앱 백그라운드 마운트를 설정하세요. 마운트된 폴더는 Finder에서 열 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte das Hintergrund-Verbinden der App ein, bevor du hier auswirfst. Verbundene Ordner kannst du weiterhin im Finder öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez le montage en arrière-plan de l’app avant d’éjecter ici. Vous pouvez toujours ouvrir les dossiers montés dans le Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el montaje en segundo plano de la app antes de expulsar aquí. Puedes seguir abriendo las carpetas montadas en el Finder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure a montagem em segundo plano do app antes de ejetar aqui. Você ainda pode abrir as pastas montadas no Finder."
          }
        }
      }
    },
    "Background mounting is changing. Wait for it to finish, then check again.": {
      "comment": "Action guidance while a background ownership transition runs. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background mounting is changing. Wait for it to finish, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台挂载正在更改。请等待完成，然后再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景掛載正在變更。請等待完成，然後再次檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドマウントを変更しています。完了を待ってから、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 마운트를 변경하는 중입니다. 완료될 때까지 기다린 후 다시 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrund-Verbinden wird gerade geändert. Warte, bis der Vorgang abgeschlossen ist, und prüfe dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage en arrière-plan est en cours de modification. Attendez la fin de l’opération, puis vérifiez à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje en segundo plano está cambiando. Espera a que termine y vuelve a comprobar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A montagem em segundo plano está sendo alterada. Aguarde a conclusão e verifique novamente."
          }
        }
      }
    },
    "App control could not be verified. Check the configuration and background service before continuing.": {
      "comment": "Action guidance when app control could not be verified. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App control could not be verified. Check the configuration and background service before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证应用控制。请先检查配置和后台服务，再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證 App 控制。請先檢查設定與背景服務，再繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appによる制御を確認できませんでした。続行する前に、設定とバックグラウンドサービスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 제어를 확인할 수 없습니다. 계속하기 전에 구성과 백그라운드 서비스를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Steuerung konnte nicht überprüft werden. Prüfe die Konfiguration und den Hintergrunddienst, bevor du fortfährst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle par l’app n’a pas pu être vérifié. Vérifiez la configuration et le service en arrière-plan avant de continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar el control por la app. Revisa la configuración y el servicio en segundo plano antes de continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o controle pelo app. Verifique a configuração e o serviço em segundo plano antes de continuar."
          }
        }
      }
    },
    "An older command-line service is installed. Update or release it before enabling app background mounting.": {
      "comment": "Guidance when an older command-line service is installed. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An older command-line service is installed. Update or release it before enabling app background mounting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装旧版命令行服务。请先更新或释放它，再启用应用后台挂载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝舊版命令列服務。請先更新或釋放它，再啟用 App 背景掛載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いコマンドラインサービスがインストールされています。Appのバックグラウンドマウントを有効にする前に、更新するか解放してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 버전의 명령줄 서비스가 설치되어 있습니다. 앱 백그라운드 마운트를 활성화하기 전에 업데이트하거나 해제하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein älterer Befehlszeilendienst ist installiert. Aktualisiere ihn oder gib ihn frei, bevor du das Hintergrund-Verbinden der App aktivierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un service en ligne de commande plus ancien est installé. Mettez-le à jour ou libérez-le avant d’activer le montage en arrière-plan de l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay instalado un servicio de línea de comandos anterior. Actualízalo o libéralo antes de activar el montaje en segundo plano de la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um serviço de linha de comando mais antigo instalado. Atualize-o ou libere-o antes de ativar a montagem em segundo plano do app."
          }
        }
      }
    },
    "The command-line service could not be checked. Confirm its installation and folder access before enabling app background mounting.": {
      "comment": "Guidance when the command-line service could not be inspected. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command-line service could not be checked. Confirm its installation and folder access before enabling app background mounting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查命令行服务。请先确认其安装状态和文件夹访问权限，再启用应用后台挂载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查命令列服務。請先確認其安裝狀態與檔案夾存取權限，再啟用 App 背景掛載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドラインサービスを確認できませんでした。Appのバックグラウンドマウントを有効にする前に、インストール状態とフォルダのアクセス権を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령줄 서비스를 확인할 수 없습니다. 앱 백그라운드 마운트를 활성화하기 전에 설치 상태와 폴더 접근 권한을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehlszeilendienst konnte nicht geprüft werden. Bestätige seine Installation und den Ordnerzugriff, bevor du das Hintergrund-Verbinden der App aktivierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service en ligne de commande n’a pas pu être vérifié. Confirmez son installation et l’accès aux dossiers avant d’activer le montage en arrière-plan de l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar el servicio de línea de comandos. Confirma su instalación y el acceso a carpetas antes de activar el montaje en segundo plano de la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o serviço de linha de comando. Confirme a instalação e o acesso às pastas antes de ativar a montagem em segundo plano do app."
          }
        }
      }
    },
    "Background control has not been set up. A running command-line service still needs to be checked before the app can take control.": {
      "comment": "Guidance when background control has not been set up. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background control has not been set up. A running command-line service still needs to be checked before the app can take control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置后台控制。应用接管前，仍需检查正在运行的命令行服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定背景控制。App 接管前，仍需檢查正在執行的命令列服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド制御はまだ設定されていません。Appが制御を引き継ぐ前に、実行中のコマンドラインサービスを確認する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 제어가 아직 설정되지 않았습니다. 앱이 제어를 넘겨받기 전에 실행 중인 명령줄 서비스를 확인해야 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hintergrundsteuerung wurde noch nicht eingerichtet. Ein laufender Befehlszeilendienst muss noch geprüft werden, bevor die App die Steuerung übernehmen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle en arrière-plan n’a pas encore été configuré. Un service en ligne de commande en cours d’exécution doit encore être vérifié avant que l’app puisse prendre le contrôle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control en segundo plano aún no se ha configurado. Todavía hay que comprobar el servicio de línea de comandos en ejecución antes de que la app pueda tomar el control."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle em segundo plano ainda não foi configurado. Um serviço de linha de comando em execução ainda precisa ser verificado antes que o app possa assumir o controle."
          }
        }
      }
    },
    "This shared folder is not mounted yet. Check the server connection and automatic mounting.": {
      "comment": "Error message when opening a shared folder that is not mounted. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shared folder is not mounted yet. Check the server connection and automatic mounting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此共享文件夹尚未挂载。请检查服务器连接和自动挂载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此共享檔案夾尚未掛載。請檢查伺服器連線與自動掛載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この共有フォルダはまだマウントされていません。サーバ接続と自動マウントを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 공유 폴더는 아직 마운트되지 않았습니다. 서버 연결과 자동 마운트를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser freigegebene Ordner ist noch nicht verbunden. Prüfe die Serververbindung und das automatische Verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier partagé n’est pas encore monté. Vérifiez la connexion au serveur et le montage automatique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta compartida aún no está montada. Comprueba la conexión con el servidor y el montaje automático."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta compartilhada ainda não está montada. Verifique a conexão com o servidor e a montagem automática."
          }
        }
      }
    },
    "Another volume occupies this shared folder’s location. Eject that volume in Finder before continuing.": {
      "comment": "Error message when another volume occupies the mount location. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another volume occupies this shared folder’s location. Eject that volume in Finder before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个宗卷占用了此共享文件夹的位置。请先在 Finder 中弹出该宗卷，再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個卷宗佔用了此共享檔案夾的位置。請先在 Finder 中退出該卷宗，再繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のボリュームがこの共有フォルダの場所を使用しています。続行する前に、Finderでそのボリュームを取り出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 볼륨이 이 공유 폴더의 위치를 차지하고 있습니다. 계속하기 전에 Finder에서 해당 볼륨을 추출하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Volume belegt den Speicherort dieses freigegebenen Ordners. Wirf dieses Volume im Finder aus, bevor du fortfährst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre volume occupe l’emplacement de ce dossier partagé. Éjectez ce volume dans le Finder avant de continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro volumen ocupa la ubicación de esta carpeta compartida. Expulsa ese volumen en el Finder antes de continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro volume ocupa o local desta pasta compartilhada. Ejete esse volume no Finder antes de continuar."
          }
        }
      }
    },
    "This shared folder could not be opened. Check its mount status and folder access.": {
      "comment": "Generic error message for opening a shared folder. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
