    "Automnt mounts your shared folders in the background when the server is reachable and the saved sign-in details are valid.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt mounts your shared folders in the background when the server is reachable and the saved sign-in details are valid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当服务器可达且已保存的登录信息有效时，Automnt 会在后台挂载你的共享文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當伺服器可連線且已儲存的登入資訊有效時，Automnt 會在背景掛載你的共享檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに到達でき、保存されたサインイン情報が有効なとき、Automnt はバックグラウンドで共有フォルダをマウントします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 있고 저장된 로그인 정보가 유효하면 Automnt가 백그라운드에서 공유 폴더를 마운트합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt bindet deine freigegebenen Ordner im Hintergrund ein, wenn der Server erreichbar ist und die gesicherten Anmeldedaten gültig sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt monte vos dossiers partagés en arrière-plan lorsque le serveur est accessible et les identifiants enregistrés valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt monta tus carpetas compartidas en segundo plano cuando el servidor es accesible y las credenciales guardadas son válidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Automnt monta suas pastas compartilhadas em segundo plano quando o servidor está acessível e as credenciais salvas são válidas."
          }
        }
      }
    },
    "Automnt uses notifications only for shared folders it could not mount automatically.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt uses notifications only for shared folders it could not mount automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt 只对未能自动挂载的共享文件夹发送通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt 只對未能自動掛載的共享檔案夾傳送通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt は自動マウントできなかった共有フォルダについてのみ通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt는 자동으로 마운트하지 못한 공유 폴더에 대해서만 알림을 보냅니다."
          }
        },
        "de": {
