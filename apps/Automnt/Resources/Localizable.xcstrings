        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Einbinden ist aus, daher werden deine freigegebenen Ordner nach Anmeldung oder Netzwerkänderungen nicht für dich eingebunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage automatique est désactivé : vos dossiers partagés ne sont pas montés pour vous après une connexion ou un changement de réseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje automático está desactivado, así que tus carpetas compartidas no se montan tras iniciar sesión o cambiar de red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A montagem automática está desativada, então suas pastas compartilhadas não são montadas após login ou mudanças de rede."
          }
        }
      }
    },
