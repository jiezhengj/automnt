    "The license could not be loaded. Reinstall Automnt to restore its bundled resources.": {
      "comment": "Offline help destination or guidance. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The license could not be loaded. Reinstall Automnt to restore its bundled resources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入许可。请重新安装 Automnt 以恢复随应用提供的资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入授權。請重新安裝 Automnt 以還原隨附資源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンスを読み込めません。Automntを再インストールして同梱リソースを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스를 불러올 수 없습니다. Automnt를 다시 설치하여 포함된 리소스를 복원하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lizenz konnte nicht geladen werden. Installieren Sie Automnt erneut, um die enthaltenen Ressourcen wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la licence. Réinstallez Automnt pour restaurer les ressources incluses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la licencia. Reinstala Automnt para restaurar los recursos incluidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a licença. Reinstale Automnt para restaurar os recursos incluídos."
          }
        }
      }
    },
    "Enabled background mounting continues after you quit Automnt. Turn off automatic mounting in Settings to stop future automatic mounts; mounted shared folders remain available.": {
      "comment": "Offline help destination or guidance. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled background mounting continues after you quit Automnt. Turn off automatic mounting in Settings to stop future automatic mounts; mounted shared folders remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Automnt 后，已启用的后台挂载继续运行。要停止后续自动挂载，请在设置中关闭自动挂载；已挂载的共享文件夹仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 Automnt 後，已啟用的背景掛載繼續執行。若要停止後續自動掛載，請在設定中關閉自動掛載；已掛載的共享檔案夾仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Automntを終了しても、有効なバックグラウンドマウントは続きます。今後の自動マウントを停止するには設定で自動マウントをオフにします。マウント済みの共有フォルダは引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt를 종료해도 활성화된 백그라운드 마운트는 계속됩니다. 이후 자동 마운트를 중지하려면 설정에서 자동 마운트를 끄세요. 마운트된 공유 폴더는 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktivierte Hintergrund-Einbindung läuft nach dem Beenden von Automnt weiter. Deaktivieren Sie die automatische Einbindung in den Einstellungen, um künftige Einbindungen zu stoppen. Eingebundene Freigaben bleiben verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage en arrière-plan activé continue après la fermeture d’Automnt. Désactivez le montage automatique dans les réglages pour arrêter les futurs montages. Les dossiers partagés montés restent disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje en segundo plano activado continúa al salir de Automnt. Desactiva el montaje automático en Ajustes para detener los montajes futuros. Las carpetas compartidas montadas siguen disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A montagem em segundo plano ativada continua após encerrar Automnt. Desative a montagem automática nos ajustes para interromper futuras montagens. As pastas compartilhadas montadas continuam disponíveis."
          }
        }
      }
    },
