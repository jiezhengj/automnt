            "state": "translated",
            "value": "Automnt verwendet Mitteilungen nur für freigegebene Ordner, die nicht automatisch eingebunden werden konnten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt n’utilise les notifications que pour les dossiers partagés qui n’ont pas pu être montés automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt usa notificaciones solo para las carpetas compartidas que no pudo montar automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Automnt usa notificações apenas para pastas compartilhadas que não pôde montar automaticamente."
          }
        }
      }
    },
    "Automnt will no longer mount this shared folder automatically. It stays mounted, and your files and saved sign-in details are not deleted.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt will no longer mount this shared folder automatically. It stays mounted, and your files and saved sign-in details are not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt 将不再自动挂载此共享文件夹。它保持挂载状态，你的文件和系统已保存的登录信息不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt 將不再自動掛載此共享檔案夾。它保持掛載狀態，你的檔案和系統已儲存的登入資訊不會被刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt はこの共有フォルダを自動マウントしなくなります。マウントは維持され、ファイルやシステムに保存されたサインイン情報は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt는 이 공유 폴더를 더 이상 자동으로 마운트하지 않습니다. 마운트는 유지되며 파일과 시스템에 저장된 로그인 정보는 삭제되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt bindet diesen freigegebenen Ordner nicht mehr automatisch ein. Er bleibt eingebunden, und deine Dateien und gesicherten Anmeldedaten werden nicht gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt ne montera plus automatiquement ce dossier partagé. Il reste monté, et vos fichiers ainsi que les identifiants enregistrés ne sont pas supprimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt dejará de montar automáticamente esta carpeta compartida. Sigue montada y no se eliminan tus archivos ni las credenciales guardadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Automnt deixará de montar automaticamente esta pasta compartilhada. Ela continua montada, e seus arquivos e credenciais salvas não são excluídos."
          }
        }
      }
    },
