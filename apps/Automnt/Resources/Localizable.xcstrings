    "Other shared folders of this server keep their own addresses and locations. An already mounted shared folder stays where it is.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other shared folders of this server keep their own addresses and locations. An already mounted shared folder stays where it is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器的其他共享文件夹保留各自的地址和位置。已经挂载的共享文件夹保持原位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器的其他共享檔案夾保留各自的位址和位置。已經掛載的共享檔案夾保持原位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバのほかの共有フォルダはそれぞれのアドレスと場所を保ちます。すでにマウントされている共有フォルダはその場所のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버의 다른 공유 폴더는 각자의 주소와 위치를 유지합니다. 이미 마운트된 공유 폴더는 있던 위치에 그대로 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere freigegebene Ordner dieses Servers behalten ihre eigenen Adressen und Speicherorte. Ein bereits eingebundener freigegebener Ordner bleibt, wo er ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres dossiers partagés de ce serveur conservent leurs propres adresses et emplacements. Un dossier déjà monté reste où il est."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás carpetas compartidas de este servidor conservan sus propias direcciones y ubicaciones. Una carpeta ya montada permanece donde está."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras pastas compartilhadas deste servidor mantêm seus próprios endereços e locais. Uma pasta já montada permanece onde está."
          }
        }
      }
    },
    "Paused after you ejected it. It stays disconnected until the network or sign-in changes, or until you mount it.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused after you ejected it. It stays disconnected until the network or sign-in changes, or until you mount it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你弹出后已暂停。在网络或登录状态变化前、或你手动挂载前，它保持断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你退出後已暫停。在網路或登入狀態變化前、或你手動掛載前，它保持中斷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り出したため一時停止しています。ネットワークかサインインが変わるまで、または手動でマウントするまで接続されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출하여 일시 중지되었습니다. 네트워크나 로그인 상태가 바뀌거나 직접 마운트할 때까지 연결되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Auswerfen pausiert. Es bleibt getrennt, bis sich Netzwerk oder Anmeldung ändern oder du es einbindest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause après votre éjection. Il reste déconnecté jusqu’à un changement de réseau ou de session, ou jusqu’à ce que vous le montiez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa tras expulsarlo. Permanece desconectado hasta que cambie la red o la sesión, o hasta que lo montes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado após você ejetá-lo. Permanece desconectado até a rede ou o login mudar, ou até você montá-lo."
          }
        }
      }
    },
