    "Saving removes this shared folder from automatic mounting. The mounted folder and saved credentials remain available.": {
      "comment": "Draft removal confirmation; saving only removes configuration, never unmounts or deletes credentials. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving removes this shared folder from automatic mounting. The mounted folder and saved credentials remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后，此共享文件夹将不再自动挂载。已挂载的文件夹和已保存的凭据仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後，此共享檔案夾將不再自動掛載。已掛載的檔案夾和已儲存的憑證仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、この共有フォルダは自動マウントの対象から外れます。マウント済みのフォルダと保存済みの認証情報は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 이 공유 폴더가 자동 마운트 대상에서 제거됩니다. 마운트된 폴더와 저장된 자격 증명은 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Speichern wird dieser Ordner nicht mehr automatisch gemountet. Der gemountete Ordner und gespeicherte Zugangsdaten bleiben verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après enregistrement, ce dossier ne sera plus monté automatiquement. Le dossier monté et les identifiants enregistrés restent disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, esta carpeta dejará de montarse automáticamente. La carpeta montada y las credenciales guardadas seguirán disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao salvar, esta pasta deixará de ser montada automaticamente. A pasta montada e as credenciais salvas continuarão disponíveis."
          }
        }
      }
    },
    "%lld shared folders need attention": {
