    "When this is off, this server’s shared folders are no longer mounted automatically. Shared folders that are already mounted stay available.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, this server’s shared folders are no longer mounted automatically. Shared folders that are already mounted stay available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，不再自动挂载此服务器的共享文件夹。已经挂载的共享文件夹仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，不再自動掛載此伺服器的共享檔案夾。已經掛載的共享檔案夾仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、このサーバの共有フォルダは自動マウントされなくなります。すでにマウントされている共有フォルダは引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 이 서버의 공유 폴더는 더 이상 자동으로 마운트되지 않습니다. 이미 마운트된 공유 폴더는 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dies aus ist, werden die freigegebenen Ordner dieses Servers nicht mehr automatisch eingebunden. Bereits eingebundene freigegebene Ordner bleiben verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette option est désactivée, les dossiers partagés de ce serveur ne sont plus montés automatiquement. Les dossiers déjà montés restent disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se desactiva, las carpetas compartidas de este servidor dejan de montarse automáticamente. Las que ya están montadas siguen disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se isto estiver desativado, as pastas compartilhadas deste servidor deixam de ser montadas automaticamente. As que já estão montadas continuam disponíveis."
          }
        }
      }
    },
    "When this is off, this shared folder is no longer mounted automatically. It stays available if it is already mounted. The server and global automatic mounting must also be on.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, this shared folder is no longer mounted automatically. It stays available if it is already mounted. The server and global automatic mounting must also be on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，此共享文件夹不再自动挂载。已经挂载时仍可使用。服务器的自动挂载与全局自动挂载也须开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，此共享檔案夾不再自動掛載。已經掛載時仍可使用。伺服器的自動掛載與全域自動掛載也須開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、この共有フォルダは自動マウントされなくなります。すでにマウントされていれば引き続き利用できます。サーバと全体の自動マウントもオンである必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 이 공유 폴더는 더 이상 자동으로 마운트되지 않습니다. 이미 마운트되어 있으면 계속 사용할 수 있습니다. 서버와 전역 자동 마운트도 켜져 있어야 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dies aus ist, wird dieser freigegebene Ordner nicht mehr automatisch eingebunden. Er bleibt verfügbar, wenn er bereits eingebunden ist. Automatisches Einbinden für den Server und global muss ebenfalls an sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette option est désactivée, ce dossier partagé n’est plus monté automatiquement. Il reste disponible s’il est déjà monté. Le montage automatique du serveur et global doit aussi être activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se desactiva, esta carpeta compartida deja de montarse automáticamente. Sigue disponible si ya está montada. El montaje automático del servidor y el global también deben estar activados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se isto estiver desativado, esta pasta compartilhada deixa de ser montada automaticamente. Continua disponível se já estiver montada. A montagem automática do servidor e global também precisa estar ativada."
          }
        }
      }
    },
    "When this is off, you still receive notifications.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, you still receive notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，你仍会收到通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，你仍會收到通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにしても通知は届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼도 알림은 계속 받습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dies aus ist, erhältst du weiterhin Mitteilungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette option est désactivée, vous recevez toujours les notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se desactiva, sigues recibiendo notificaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se isto estiver desativado, você ainda recebe notificações."
          }
        }
      }
    },
    "While automatic mounting is off, you can still mount or eject a single shared folder from its row in the main window.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While automatic mounting is off, you can still mount or eject a single shared folder from its row in the main window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动挂载关闭时，你仍可在主窗口的行上单独挂载或弹出某个共享文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動掛載關閉時，你仍可在主視窗的列上單獨掛載或退出某個共享檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動マウントがオフでも、メインウインドウの行から共有フォルダを個別にマウントまたは取り出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 마운트가 꺼져 있어도 기본 윈도우의 행에서 공유 폴더 하나를 마운트하거나 추출할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch wenn das automatische Einbinden aus ist, kannst du in der Hauptfensterzeile einen einzelnen freigegebenen Ordner einbinden oder auswerfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si le montage automatique est désactivé, vous pouvez monter ou éjecter un dossier partagé depuis sa ligne dans la fenêtre principale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque el montaje automático esté desactivado, puedes montar o expulsar una carpeta compartida desde su fila en la ventana principal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo com a montagem automática desativada, você pode montar ou ejetar uma pasta compartilhada em sua linha na janela principal."
          }
        }
      }
    },
    "Your configuration could not be read, so its settings are not shown. Automatic mounting keeps its previous state until the configuration is readable.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your configuration could not be read, so its settings are not shown. Automatic mounting keeps its previous state until the configuration is readable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取你的配置，因此没有显示它的设置。在配置可读之前，自动挂载保持之前的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取你的設定，因此沒有顯示它的設定。在設定可讀之前，自動掛載保持之前的狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み取れないため、その設定は表示されていません。設定が読み取れるまで、自動マウントは以前の状態を保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성을 읽을 수 없어 해당 설정이 표시되지 않습니다. 구성을 읽을 수 있을 때까지 자동 마운트는 이전 상태를 유지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Konfiguration konnte nicht gelesen werden, daher werden ihre Einstellungen nicht angezeigt. Das automatische Einbinden behält seinen vorherigen Zustand, bis die Konfiguration lesbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre configuration n’a pas pu être lue, ses réglages ne sont donc pas affichés. Le montage automatique conserve son état précédent jusqu’à ce que la configuration soit lisible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer tu configuración, por lo que no se muestran sus ajustes. El montaje automático mantiene su estado anterior hasta que la configuración sea legible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler sua configuração, então seus ajustes não são exibidos. A montagem automática mantém o estado anterior até que a configuração possa ser lida."
          }
        }
      }
    },
    "Your configuration could not be read. Check folder access and try again. Automnt has not created a new configuration.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your configuration could not be read. Check folder access and try again. Automnt has not created a new configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取你的配置。请检查文件夹访问权限后重试。Automnt 没有创建新的配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取你的設定。請檢查檔案夾存取權限後再試一次。Automnt 沒有建立新的設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み取れませんでした。フォルダへのアクセスを確認して、もう一度お試しください。Automnt は新しい設定を作成していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성을 읽을 수 없습니다. 폴더 접근 권한을 확인한 후 다시 시도하세요. Automnt는 새 구성을 만들지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Konfiguration konnte nicht gelesen werden. Prüfe den Ordnerzugriff und versuche es erneut. Automnt hat keine neue Konfiguration erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre configuration n’a pas pu être lue. Vérifiez l’accès au dossier et réessayez. Automnt n’a pas créé de nouvelle configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer tu configuración. Comprueba el acceso a la carpeta e inténtalo de nuevo. Automnt no ha creado una configuración nueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
