    "Your edits are not saved yet. Save them before Automnt quits, or discard them.": {
      "comment": "Draft translations require native review; field-level validation or quit confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
