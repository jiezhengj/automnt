    "Automatic mounting is off. Turn it on in Automnt Settings before setting up background mounting.": {
      "comment": "Guidance shown when background mounting needs automatic mounting enabled first. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic mounting is off. Turn it on in Automnt Settings before setting up background mounting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动挂载已关闭。请先在 Automnt 设置中开启，再设置后台挂载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動掛載已關閉。請先在 Automnt 設定中開啟，再設定背景掛載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動マウントはオフです。バックグラウンドマウントを設定する前に、Automntの設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 마운트가 꺼져 있습니다. 백그라운드 마운트를 설정하기 전에 Automnt 설정에서 켜세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Verbinden ist aus. Aktiviere es in den Automnt-Einstellungen, bevor du das Hintergrund-Verbinden einrichtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage automatique est désactivé. Activez-le dans les réglages Automnt avant de configurer le montage en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje automático está desactivado. Actívalo en los ajustes de Automnt antes de configurar el montaje en segundo plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A montagem automática está desativada. Ative-a nos ajustes do Automnt antes de configurar a montagem em segundo plano."
          }
        }
      }
    },
    "Stops the app background service, then applies your current automatic mounting settings. Mounted shared folders remain available.": {
      "comment": "Explanation shown next to the repair action. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops the app background service, then applies your current automatic mounting settings. Mounted shared folders remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止应用后台服务，然后应用你当前的自动挂载设置。已挂载的共享文件夹仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 App 背景服務，然後套用你目前的自動掛載設定。已掛載的共享檔案夾仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appのバックグラウンドサービスを停止してから、現在の自動マウント設定を適用します。マウント済みの共有フォルダは引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 백그라운드 서비스를 중지한 다음 현재 자동 마운트 설정을 적용합니다. 마운트된 공유 폴더는 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet den Hintergrunddienst der App und wendet dann deine aktuellen Einstellungen für das automatische Verbinden an. Verbundene freigegebene Ordner bleiben verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le service en arrière-plan de l’app, puis applique vos réglages actuels de montage automatique. Les dossiers partagés montés restent disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el servicio en segundo plano de la app y aplica tus ajustes actuales de montaje automático. Las carpetas compartidas montadas siguen disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe o serviço em segundo plano do app e aplica suas definições atuais de montagem automática. As pastas compartilhadas montadas continuam disponíveis."
          }
        }
      }
    },
