    "App background mounting is not active. Set up the app’s background service before using this action.": {
      "comment": "Error message when another owner controls mounting. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App background mounting is not active. Set up the app’s background service before using this action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用后台挂载未生效。请先设置应用的后台服务，再使用此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 背景掛載未生效。請先設定 App 的背景服務，再使用此操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appのバックグラウンドマウントは有効ではありません。この操作を行う前に、Appのバックグラウンドサービスを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 백그라운드 마운트가 활성화되어 있지 않습니다. 이 작업을 사용하기 전에 앱의 백그라운드 서비스를 설정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrund-Verbinden der App ist nicht aktiv. Richte den Hintergrunddienst der App ein, bevor du diese Aktion verwendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage en arrière-plan de l’app n’est pas actif. Configurez le service en arrière-plan de l’app avant d’utiliser cette action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje en segundo plano de la app no está activo. Configura el servicio en segundo plano de la app antes de usar esta acción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A montagem em segundo plano do app não está ativa. Configure o serviço em segundo plano do app antes de usar esta ação."
          }
        }
      }
    },
    "The shared folder is in use. Close files and apps using it, then try ejecting again.": {
      "comment": "Error message when the volume is busy during eject. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared folder is in use. Close files and apps using it, then try ejecting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享文件夹正在使用中。请关闭正在使用它的文件和 App，然后再次尝试弹出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享檔案夾正在使用中。請關閉正在使用它的檔案與 App，然後再次嘗試退出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダは使用中です。使用しているファイルやAppを閉じてから、もう一度取り出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 폴더가 사용 중입니다. 사용 중인 파일과 앱을 닫은 후 다시 추출하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der freigegebene Ordner wird verwendet. Schließe die zugehörigen Dateien und Apps und versuche dann erneut auszuwerfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier partagé est utilisé. Fermez les fichiers et apps qui l’utilisent, puis réessayez d’éjecter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta compartida está en uso. Cierra los archivos y apps que la usen y vuelve a intentar expulsarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta compartilhada está em uso. Feche os arquivos e apps que a utilizam e tente ejetar novamente."
          }
        }
      }
    },
    "The operation could not be confirmed. Check background service status before trying again.": {
      "comment": "Error message for a timeout or unavailable signal. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation could not be confirmed. Check background service status before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认该操作。请先检查后台服务状态，再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認該操作。請先檢查背景服務狀態，再重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を確認できませんでした。再試行する前にバックグラウンドサービスの状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 확인할 수 없습니다. 다시 시도하기 전에 백그라운드 서비스 상태를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang konnte nicht bestätigt werden. Prüfe den Status des Hintergrunddienstes, bevor du es erneut versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération n’a pas pu être confirmée. Vérifiez l’état du service en arrière-plan avant de réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido confirmar la operación. Comprueba el estado del servicio en segundo plano antes de volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a operação. Verifique o status do serviço em segundo plano antes de tentar novamente."
          }
        }
      }
    },
    "The change could not be saved. Check folder access and try again.": {
      "comment": "Generic error message when saving fails. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change could not be saved. Check folder access and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储更改。请检查文件夹访问权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存變更。請檢查檔案夾存取權限後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存できませんでした。フォルダのアクセス権を確認して、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장할 수 없습니다. 폴더 접근 권한을 확인한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung konnte nicht gesichert werden. Prüfe den Ordnerzugriff und versuche es erneut."
          }
        },
        "fr": {
