    "Check folder access and try again. Automnt has not created a new configuration.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check folder access and try again. Automnt has not created a new configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查文件夹访问权限后重试。Automnt 没有创建新的配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查檔案夾存取權限後再試一次。Automnt 沒有建立新的設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダへのアクセスを確認して、もう一度お試しください。Automnt は新しい設定を作成していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 접근 권한을 확인한 후 다시 시도하세요. Automnt는 새 구성을 만들지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Ordnerzugriff und versuche es erneut. Automnt hat keine neue Konfiguration erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’accès au dossier et réessayez. Automnt n’a pas créé de nouvelle configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el acceso a la carpeta e inténtalo de nuevo. Automnt no ha creado una configuración nueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o acesso à pasta e tente novamente. O Automnt não criou uma nova configuração."
          }
        }
      }
    },
    "Check the address and location. The address must belong to this server and contain no user name or password, and the location must be an absolute folder path.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the address and location. The address must belong to this server and contain no user name or password, and the location must be an absolute folder path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查地址和位置。地址必须属于此服务器且不含用户名或密码，位置必须是绝对文件夹路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查位址和位置。位址必須屬於此伺服器且不含使用者名稱或密碼，位置必須是絕對檔案夾路徑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスと場所を確認してください。アドレスはこのサーバのもので、ユーザ名やパスワードを含まない必要があります。場所は絶対フォルダパスである必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소와 위치를 확인하세요. 주소는 이 서버의 것이어야 하고 사용자 이름과 암호를 포함하지 않아야 하며, 위치는 절대 폴더 경로여야 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Adresse und Speicherort. Die Adresse muss zu diesem Server gehören und darf keinen Benutzernamen und kein Passwort enthalten; der Speicherort muss ein absoluter Ordnerpfad sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’adresse et l’emplacement. L’adresse doit appartenir à ce serveur et ne contenir aucun nom d’utilisateur ni mot de passe ; l’emplacement doit être un chemin de dossier absolu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la dirección y la ubicación. La dirección debe pertenecer a este servidor y no contener nombre de usuario ni contraseña, y la ubicación debe ser una ruta de carpeta absoluta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o endereço e o local. O endereço deve pertencer a este servidor e não conter nome de usuário nem senha, e o local deve ser um caminho de pasta absoluto."
          }
        }
      }
    },
    "Check the address. It must be a complete smb://host/share address without sign-in details.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the address. It must be a complete smb://host/share address without sign-in details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查地址。它必须是完整的 smb://host/share 地址，且不含登录信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查位址。它必須是完整的 smb://host/share 位址，且不含登入資訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスを確認してください。ログイン情報を含まない完全な smb://host/share 形式が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소를 확인하세요. 로그인 정보가 없는 완전한 smb://host/share 형식이어야 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Adresse. Sie muss eine vollständige smb://host/share-Adresse ohne Anmeldedaten sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’adresse. Elle doit être une adresse smb://host/share complète, sans identifiants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
