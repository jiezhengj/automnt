    "Mount configured shared folders when the server and credentials are available. Background mounting must be enabled separately.": {
      "comment": "Settings explanation shown while automatic mounting is on. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount configured shared folders when the server and credentials are available. Background mounting must be enabled separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器和登录信息可用时，挂载已配置的共享文件夹。后台挂载需单独启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器與登入資訊可用時，掛載已設定的共享檔案夾。背景掛載需另行啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバとログイン情報を利用できるときに、設定済みの共有フォルダをマウントします。バックグラウンドマウントは別途有効にする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버와 로그인 정보를 사용할 수 있으면 구성된 공유 폴더를 마운트합니다. 백그라운드 마운트는 별도로 활성화해야 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet konfigurierte freigegebene Ordner, sobald Server und Anmeldedaten verfügbar sind. Das Hintergrund-Verbinden muss separat aktiviert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte les dossiers partagés configurés dès que le serveur et les identifiants sont disponibles. Le montage en arrière-plan doit être activé séparément."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta las carpetas compartidas configuradas cuando el servidor y las credenciales estén disponibles. El montaje en segundo plano debe activarse por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta as pastas compartilhadas configuradas quando o servidor e as credenciais estiverem disponíveis. A montagem em segundo plano deve ser ativada separadamente."
          }
        }
      }
    },
    "Mounted shared folders remain available while automatic mounting is off.": {
      "comment": "Settings explanation shown while automatic mounting is off. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mounted shared folders remain available while automatic mounting is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动挂载关闭时，已挂载的共享文件夹仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動掛載關閉時，已掛載的共享檔案夾仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動マウントがオフでも、マウント済みの共有フォルダは引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 마운트가 꺼져 있어도 마운트된 공유 폴더는 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbundene freigegebene Ordner bleiben verfügbar, solange das automatische Verbinden aus ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers partagés montés restent disponibles tant que le montage automatique est désactivé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas compartidas montadas siguen disponibles mientras el montaje automático esté desactivado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas compartilhadas montadas continuam disponíveis enquanto a montagem automática estiver desativada."
          }
        }
      }
