    "This deletes Automnt's local log files. Saved diagnostic exports are not affected.": {
      "comment": "Local log retention/clear action; draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes Automnt's local log files. Saved diagnostic exports are not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除 Automnt 的本机日志文件；已保存的诊断导出不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除 Automnt 的本機日誌檔案；已儲存的診斷匯出不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt のローカルログファイルを削除します。保存済みの診断エクスポートには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt의 로컬 로그 파일을 삭제합니다. 저장된 진단 내보내기에는 영향을 주지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht die lokalen Logdateien von Automnt. Bereits gesicherte Diagnose-Exporte sind nicht betroffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les fichiers journaux locaux d’Automnt. Les exports de diagnostics déjà enregistrés ne sont pas affectés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra los archivos de registro locales de Automnt. Los diagnósticos ya exportados no se ven afectados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga os arquivos de registro locais do Automnt. Exportações de diagnóstico já salvas não são afetadas."
