    "Background mounting could not be changed. Check the configuration and background service before continuing.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background mounting could not be changed. Check the configuration and background service before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改后台挂载。请先检查配置和后台服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法變更背景掛載。請先檢查設定和背景服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドマウントを変更できませんでした。続行する前に設定とバックグラウンドサービスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 마운트를 변경할 수 없습니다. 계속하기 전에 구성과 백그라운드 서비스를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrund-Verbinden konnte nicht geändert werden. Prüfe Konfiguration und Hintergrunddienst, bevor du fortfährst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage en arrière-plan n’a pas pu être modifié. Vérifiez la configuration et le service en arrière-plan avant de continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el montaje en segundo plano. Comprueba la configuración y el servicio en segundo plano antes de continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar a montagem em segundo plano. Verifique a configuração e o serviço em segundo plano antes de continuar."
          }
        }
      }
    },
