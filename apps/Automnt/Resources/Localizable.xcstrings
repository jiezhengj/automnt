    "The server did not accept the saved sign-in details. Reconnect this shared folder in Finder, then try again.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not accept the saved sign-in details. Reconnect this shared folder in Finder, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未接受已保存的登录信息。请在 Finder 中重新连接此共享文件夹，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器未接受已儲存的登入資訊。請在 Finder 中重新連接此共享檔案夾，然後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが保存済みのサインイン情報を受け付けませんでした。Finder でこの共有フォルダに再接続してから、もう一度お試しください。"
          }
