    "These parameters are saved together for this server. Its shared folders keep their own addresses and locations.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These parameters are saved together for this server. Its shared folders keep their own addresses and locations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些参数会为此服务器整体保存。它的共享文件夹保留各自的地址和位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些參數會為此伺服器整體儲存。它的共享檔案夾保留各自的位址和位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのパラメータはこのサーバ用にまとめて保存されます。共有フォルダはそれぞれのアドレスと場所を保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 매개변수는 이 서버에 대해 함께 저장됩니다. 공유 폴더는 각자의 주소와 위치를 유지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Parameter werden für diesen Server gemeinsam gesichert. Seine freigegebenen Ordner behalten ihre eigenen Adressen und Speicherorte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces paramètres sont enregistrés ensemble pour ce serveur. Ses dossiers partagés conservent leurs propres adresses et emplacements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos parámetros se guardan juntos para este servidor. Sus carpetas compartidas conservan sus propias direcciones y ubicaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses parâmetros são salvos em conjunto para este servidor. Suas pastas compartilhadas mantêm seus próprios endereços e locais."
          }
        }
      }
    },
    "This login setting opens only the menu bar item; it never opens the main window. Background automatic mounting runs separately.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This login setting opens only the menu bar item; it never opens the main window. Background automatic mounting runs separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此登录设置只打开菜单栏图标，不会打开主窗口。后台自动挂载独立运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此登入設定只開啟選單列圖像，不會開啟主視窗。背景自動掛載獨立執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このログイン設定はメニューバー項目だけを開きます。メインウインドウは開きません。バックグラウンドの自動マウントは別に動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그인 설정은 메뉴 막대 항목만 엽니다. 기본 윈도우는 열지 않습니다. 백그라운드 자동 마운트는 별도로 실행됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldeeinstellung öffnet nur das Menüleisten-Symbol, niemals das Hauptfenster. Das automatische Einbinden im Hintergrund läuft separat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage de connexion n’ouvre que l’élément de la barre des menus, jamais la fenêtre principale. Le montage automatique en arrière-plan fonctionne séparément."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste de inicio de sesión solo abre el elemento de la barra de menús, nunca la ventana principal. El montaje automático en segundo plano se ejecuta por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste de login abre apenas o item da barra de menus, nunca a janela principal. A montagem automática em segundo plano é executada separadamente."
          }
        }
      }
