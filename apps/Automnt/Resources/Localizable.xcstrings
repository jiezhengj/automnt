        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt needs permission to read and save your settings. Shared folders you have already configured will appear automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt 需要获得读取和保存设置的权限。已有配置的共享文件夹会自动显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt 需要取得讀取與儲存設定的權限。已設定的共享檔案夾會自動顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt が設定を読み込んで保存するには、アクセスの許可が必要です。設定済みの共有フォルダは自動的に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt가 설정을 읽고 저장하려면 접근 권한이 필요합니다. 이미 설정한 공유 폴더는 자동으로 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt benötigt deine Erlaubnis, um deine Einstellungen zu lesen und zu speichern. Bereits eingerichtete geteilte Ordner werden automatisch angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt a besoin de votre autorisation pour lire et enregistrer vos réglages. Les dossiers partagés déjà configurés s’afficheront automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt necesita tu permiso para leer y guardar tus ajustes. Las carpetas compartidas que ya hayas configurado aparecerán automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Automnt precisa da sua permissão para ler e salvar seus ajustes. As pastas compartilhadas já configuradas aparecerão automaticamente."
          }
        }
      }
    },
    "Access was not granted. Continue to allow access to Automnt’s settings.": {
      "comment": "Settings access authorization for the fixed Automnt settings folder; not a storage location choice. No format parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access was not granted. Continue to allow access to Automnt’s settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未获得访问权限。继续以允许 Automnt 访问设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未取得存取權限。請繼續以允許 Automnt 存取設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスが許可されていません。続けて、Automnt の設定へのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한이 부여되지 않았습니다. 계속 진행하여 Automnt 설정에 대한 접근을 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff wurde nicht erlaubt. Fahre fort, um den Zugriff auf die Automnt-Einstellungen zu erlauben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès n’a pas été autorisé. Continuez pour autoriser l’accès aux réglages d’Automnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido acceso. Continúa para permitir el acceso a los ajustes de Automnt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso não foi autorizado. Continue para permitir o acesso aos ajustes do Automnt."
          }
        }
      }
    },
    "Automnt could not access its settings. Allow access so it can prepare them for you.": {
      "comment": "Settings access authorization for the fixed Automnt settings folder; not a storage location choice. No format parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt could not access its settings. Allow access so it can prepare them for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt 无法访问设置。允许访问后，应用会自动准备设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt 無法存取設定。允許存取後，App 會自動準備設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt が設定にアクセスできませんでした。設定を準備できるように、アクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt가 설정에 접근할 수 없습니다. 설정을 준비할 수 있도록 접근을 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt konnte nicht auf seine Einstellungen zugreifen. Erlaube den Zugriff, damit Automnt sie für dich vorbereiten kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt n’a pas pu accéder à ses réglages. Autorisez l’accès pour qu’Automnt puisse les préparer pour vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt no pudo acceder a sus ajustes. Permite el acceso para que pueda prepararlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Automnt não conseguiu acessar seus ajustes. Permita o acesso para que ele possa prepará-los para você."
          }
        }
      }
    },
    "The saved access to your settings has expired. Allow access again to continue.": {
      "comment": "Settings access authorization for the fixed Automnt settings folder; not a storage location choice. No format parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved access to your settings has expired. Allow access again to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的访问权限已失效。请重新允许访问以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的存取權限已失效。請重新允許存取以繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定へのアクセス許可の有効期限が切れています。続けるには、もう一度アクセスを許可してください。"
