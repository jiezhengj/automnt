    },
    "The last successfully read targets are shown for reference. Changes and new mounts are unavailable until access is restored.": {
      "comment": "Fixed canonical configuration authorization. Non-English translations are drafts awaiting native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last successfully read targets are shown for reference. Changes and new mounts are unavailable until access is restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示上次成功读取的目标供参考。恢复访问前无法修改配置或新挂载共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前顯示上次成功讀取的目標供參考。恢復存取前無法修改設定或新掛載共享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に正常に読み取った接続先を参考として表示しています。アクセスが復旧するまで、変更と新しいマウントはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 읽기에 성공한 대상이 참고용으로 표시됩니다. 접근이 복구될 때까지 변경과 새 마운트는 사용할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuletzt erfolgreich gelesenen Ziele werden zur Orientierung angezeigt. Änderungen und neue Einbindungen sind erst nach Wiederherstellung des Zugriffs möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dernières destinations lues sont affichées à titre indicatif. Les modifications et les nouveaux montages sont indisponibles jusqu’au rétablissement de l’accès."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran como referencia los últimos destinos leídos correctamente. Los cambios y nuevos montajes no estarán disponibles hasta restablecer el acceso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os últimos destinos lidos com sucesso são mostrados como referência. Alterações e novas montagens ficam indisponíveis até restaurar o acesso."
          }
        }
      }
    },
