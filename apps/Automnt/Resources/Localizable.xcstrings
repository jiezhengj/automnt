    "The name and location are derived from the address. Change them if your tasks use another location.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name and mount location are derived from the address. Change them if your tasks use another mount location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称和挂载位置会根据地址推导。如果你的任务使用其他挂载位置，可以在此修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
