    "The saved folder access could not be renewed. Allow access again to read your current configuration.": {
      "comment": "Fixed canonical configuration authorization. Non-English translations are drafts awaiting native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved folder access could not be renewed. Allow access again to read your current configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新已保存的文件夹访问记录。请重新允许访问，以读取当前配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新已儲存的檔案夾存取記錄。請重新允許存取，以讀取目前設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたフォルダへのアクセスを更新できませんでした。現在の設定を読むには、もう一度アクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 폴더 접근 권한을 갱신하지 못했습니다. 현재 구성을 읽으려면 접근을 다시 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Ordnerzugriff konnte nicht erneuert werden. Erlaube den Zugriff erneut, um die aktuelle Konfiguration zu lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès enregistré au dossier n’a pas pu être renouvelé. Autorisez à nouveau l’accès pour lire votre configuration actuelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo renovar el acceso guardado a la carpeta. Permite el acceso de nuevo para leer la configuración actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível renovar o acesso salvo à pasta. Permita o acesso novamente para ler sua configuração atual."
          }
        }
      }
    },
    "Automnt can no longer access the configuration folder. Allow access again. Your configuration has not been replaced.": {
