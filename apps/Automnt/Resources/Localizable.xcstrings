      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared folders that disconnect unexpectedly get an extra attempt when the volume setup changes. Automatic mounting after sign-in or a network change still runs when this is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享文件夹意外断开时，会在卷宗配置变化后额外尝试一次。关闭此项后，登录或网络变化时的自动挂载仍会运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享檔案夾意外中斷時，會在卷宗設定變化後額外嘗試一次。關閉此項後，登入或網路變化時的自動掛載仍會執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダが予期せず切断された場合、ボリューム構成の変化時に追加で試行します。これをオフにしても、サインインやネットワーク変化時の自動マウントは実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 폴더가 예기치 않게 끊기면 볼륨 구성이 바뀔 때 한 번 더 시도합니다. 이 옵션을 꺼도 로그인이나 네트워크 변화 시 자동 마운트는 계속 실행됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unerwartet getrennte freigegebene Ordner erhalten einen zusätzlichen Versuch, wenn sich die Volume-Konfiguration ändert. Das automatische Einbinden bei Anmeldung oder Netzwerkänderung läuft auch dann weiter, wenn dies aus ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers partagés qui se déconnectent de façon inattendue bénéficient d’une tentative supplémentaire lors d’un changement de volume. Le montage automatique à la connexion ou lors d’un changement de réseau reste actif même si cette option est désactivée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas compartidas que se desconectan de forma inesperada reciben un intento adicional cuando cambia la configuración de volúmenes. El montaje automático al iniciar sesión o al cambiar de red sigue funcionando aunque esto esté desactivado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas compartilhadas que se desconectam inesperadamente recebem uma tentativa extra quando a configuração de volumes muda. A montagem automática no login ou em mudanças de rede continua funcionando mesmo com isto desativado."
          }
        }
      }
    },
    "Shared with the command-line tool. A round makes at most this many attempts and does not keep polling while idle.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared with the command-line tool. A round makes at most this many attempts and does not keep polling while idle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与命令行工具共用。一轮最多尝试这么多次，空闲时不会持续轮询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與命令列工具共用。一輪最多嘗試這麼多次，閒置時不會持續輪詢。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドラインツールと共通です。1 回の確認で最大この回数だけ試行し、アイドル中はポーリングしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령줄 도구와 공유됩니다. 한 회차에서 최대 이 횟수만큼 시도하며 유휴 시 계속 폴링하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird mit dem Befehlszeilenwerkzeug geteilt. Eine Runde versucht es höchstens so oft und fragt im Leerlauf nicht laufend nach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagé avec l’outil en ligne de commande. Un cycle effectue au plus ce nombre de tentatives et ne sonde pas en continu au repos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartido con la herramienta de línea de comandos. Una ronda hace como máximo este número de intentos y no sondea continuamente en reposo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhado com a ferramenta de linha de comando. Uma rodada faz no máximo esse número de tentativas e não fica sondando ociosa."
          }
        }
      }
    },
