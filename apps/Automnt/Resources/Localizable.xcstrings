    "Enter a valid server address, a port from 1 to 65535, and a probe timeout from 100 to 30000 ms.": {
      "comment": "Main window rework (FR-027..FR-031). Draft translations need native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid server address, a port from 1 to 65535, and a probe timeout from 100 to 30000 ms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的服务器地址、1–65535 的端口和 100–30000 毫秒的探测超时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
