{
  "sourceLanguage": "en",
  "strings": {
    "Automnt could not confirm that no CLI configuration exists. Your input is preserved. Resolve the CLI configuration before saving in the app.": {
      "comment": "First-save refusal when a legacy configuration exists or cannot be inspected. Draft translations require native review; no migration completion is promised.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt could not confirm that no CLI configuration exists. Your input is preserved. Resolve the CLI configuration before saving in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认是否已有 CLI 配置。你的输入已保留。请先处理 CLI 配置，再在应用中存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認是否已有 CLI 設定。你的輸入已保留。請先處理 CLI 設定，再於 App 中儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI の設定が存在しないことを確認できませんでした。入力内容は保持されています。アプリで保存する前に CLI の設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 구성이 없는지 확인할 수 없습니다. 입력 내용은 유지됩니다. 앱에서 저장하기 전에 CLI 구성을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt konnte nicht bestätigen, dass keine CLI-Konfiguration vorhanden ist. Deine Eingaben bleiben erhalten. Kläre die CLI-Konfiguration, bevor du in der App speicherst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt n’a pas pu confirmer l’absence de configuration CLI. Votre saisie est conservée. Vérifiez la configuration CLI avant d’enregistrer dans l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automnt no pudo confirmar que no exista una configuración de CLI. Se conservan tus datos. Revisa la configuración de CLI antes de guardar en la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Automnt não conseguiu confirmar a ausência de configuração da CLI. Seus dados foram preservados. Verifique a configuração da CLI antes de salvar no app."
          }
        }
      }
    },
    "Add servers and shared folders to mount automatically.": {
      "comment": "First setup explanation; draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add servers and shared folders to mount automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加服务器和共享文件夹，让 Automnt 自动挂载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入伺服器與共享檔案夾，讓 Automnt 自動掛載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的にマウントするサーバと共有フォルダを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 마운트할 서버와 공유 폴더를 추가하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Server und geteilte Ordner hinzu, die automatisch verbunden werden sollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des serveurs et des dossiers partagés à monter automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade servidores y carpetas compartidas para montarlos automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione servidores e pastas compartilhadas para montá-los automaticamente."
          }
        }
      }
    },
    "Background mounting cannot access the configuration folder. Keep Automnt open to manage your configuration; the background service has not been changed.": {
      "comment": "Helper authorization preflight failure before service handoff. No parameters. Draft translations require native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background mounting cannot access the configuration folder. Keep Automnt open to manage your configuration; the background service has not been changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台挂载无法访问配置文件夹。请保持 Automnt 打开以管理配置；后台服务未作更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景掛載無法存取設定檔案夾。請保持 Automnt 開啟以管理設定；背景服務未作變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドマウントが設定フォルダにアクセスできません。設定を管理するには Automnt を開いたままにしてください。バックグラウンドサービスは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 마운트가 설정 폴더에 접근할 수 없습니다. 설정을 관리하려면 Automnt를 열어 두세요. 백그라운드 서비스는 변경되지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Einbinden im Hintergrund kann nicht auf den Konfigurationsordner zugreifen. Lass Automnt zur Verwaltung der Konfiguration geöffnet. Der Hintergrunddienst wurde nicht geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage en arrière-plan ne peut pas accéder au dossier de configuration. Gardez Automnt ouvert pour gérer la configuration. Le service en arrière-plan n’a pas été modifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje en segundo plano no puede acceder a la carpeta de configuración. Mantén Automnt abierto para gestionar la configuración. El servicio en segundo plano no se ha modificado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A montagem em segundo plano não pode acessar a pasta de configuração. Mantenha o Automnt aberto para gerenciar a configuração. O serviço em segundo plano não foi alterado."
          }
        }
      }
    },
